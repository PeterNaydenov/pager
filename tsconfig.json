{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "rootDir": "src",
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "removeComments": false,
        "skipLibCheck": true,
        "strict": false,
        "noImplicitAny": false
    },
    "include": [
        "src/**/*.js",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "test",
        "coverage"
    ]
}
