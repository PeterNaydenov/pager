{
  "name": "@peter.naydenov/pager",
  "description": "A library to split results into multiple pages",
  "version": "1.0.5",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "src/main.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./src/main.js",
      "require": "./dist/pager.cjs",
      "default": "./src/main.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "types": "./dist/main.d.ts",
  "files": [
    "dist",
    "src",
    "Changelog.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c && tsc",
    "build:types": "tsc",
    "test": "vitest run",
    "cover": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/pager.git"
  },
  "keywords": [
    "result",
    "pager"
  ],
  "dependencies": {
    "@peter.naydenov/stack": "^3.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "rollup": "^4.62.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
