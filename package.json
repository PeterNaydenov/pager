{
  "name": "@peter.naydenov/pager",
  "description": "A library to split results into multiple pages",
  "version": "1.0.4",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "src/main.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./src/main.js",
      "require": "./dist/pager.cjs",
      "default": "./src/main.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "types": "./dist/main.d.ts",
  "files": [
    "dist",
    "src",
    "Changelog.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c && tsc",
    "build:types": "tsc",
    "test": "mocha test",
    "cover": "c8 mocha test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/pager.git"
  },
  "keywords": [
    "result",
    "pager"
  ],
  "dependencies": {
    "@peter.naydenov/stack": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "rollup": "^4.62.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5"
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "node_modules",
      "test",
      "test-data"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
